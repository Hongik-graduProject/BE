SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Supabase
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-do-not-expose-client>
# local: leave unset — application-local.yml supplies a dev default and /dev/auth/token mints
# matching tokens. prod: MUST be the real Supabase project JWT secret.
SUPABASE_JWT_SECRET=<jwt-secret-from-supabase-settings-api>

# DB (Supabase Postgres direct connection)
DB_URL=jdbc:postgresql://<host>.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=<issued-password>

# Redis (local docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6379

# External APIs
DART_API_KEY=<https://opendart.fss.or.kr/ issued>
KRX_API_BASE_URL=https://openapi.koreainvestment.com:9443
KRX_API_KEY=<KRX OpenAPI or KIS OpenAPI issued>
KRX_API_SECRET=<KIS secret if applicable>

# Firebase
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-admin.json
FIREBASE_PROJECT_ID=<gcp-project-id>

# ThemeSense ETL (CLI input)
THEMESENSE_ARTIFACTS_DIR=/absolute/path/to/hongik_ML/Trading-Strategies-by-Theme/data/artifacts
THEMESENSE_STAGE1_VERSION=themesense-stage1-v1.0
THEMESENSE_STAGE2_VERSION=themesense-stage2-v1.0

# ML model service (ML repo `boseong` branch FastAPI; leave blank to disable the forecast)
ML_API_BASE_URL=http://localhost:8000
ML_API_KEY=<KOSPI_API_API_KEY set on the model service>
