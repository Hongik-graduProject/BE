SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# JWT (백엔드가 직접 발급·검증)
JWT_SECRET=<32자 이상 랜덤 문자열>
# local: leave unset. application-local.yml supplies a dev default so the app boots.
# prod: MUST be a random value of at least 32 characters.

# DB (local docker-compose Postgres)
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis (local docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6379

# External APIs
DART_API_KEY=<https://opendart.fss.or.kr/ issued>
KRX_API_BASE_URL=https://openapi.koreainvestment.com:9443
KRX_API_KEY=<KRX OpenAPI or KIS OpenAPI issued>
KRX_API_SECRET=<KIS secret if applicable>

# Firebase
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-admin.json
FIREBASE_PROJECT_ID=<gcp-project-id>

# ThemeSense 산출물 폴더. 설정하면 종목 적재 직후 stock_themes 가 비어 있을 때 한 번 자동 적재한다.
# 데모용 규칙 기반 산출물: demo/themesense (scripts/generate_demo_themesense.py 로 생성). 모델 산출물이 생기면 그 폴더로 바꾼다.
THEMESENSE_ARTIFACTS_DIR=demo/themesense
THEMESENSE_STAGE1_VERSION=themesense-stage1-v1.0
THEMESENSE_STAGE2_VERSION=themesense-stage2-v1.0

# ML model service (ML repo `boseong` branch FastAPI; leave blank to disable the forecast)
ML_API_BASE_URL=http://localhost:8000
ML_API_KEY=<KOSPI_API_API_KEY set on the model service>
