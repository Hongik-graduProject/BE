# Default: normalize text files to LF in the repo
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Must stay LF — executed inside Linux containers (Dockerfile, CI)
gradlew text eol=lf

# Never touch these
*.jar   binary
*.png   binary
*.jpg   binary
*.ico   binary
